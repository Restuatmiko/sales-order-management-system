@model List<FrontEnd.Models.SalesOrderResponse>

@{
    ViewData["Title"] = "Sales Order";
}

<style>
    .sales-order-page {
        padding: 24px 30px;
    }

    .sales-order-wrapper {
        max-width: 1400px;
        margin: 0 auto;
    }

    /* Header */
    .page-title {
        color: #203f67;
        font-size: 24px;
        font-weight: 700;
        margin: 0;
    }

    .page-actions {
        display: flex;
        gap: 8px;
        align-items: center;
    }

    .btn-add-new {
        background-color: #198754;
        border: 1px solid #198754;
        color: white;
        font-size: 14px;
        font-weight: 600;
        padding: 7px 14px;
        border-radius: 4px;
        text-decoration: none;
    }

        .btn-add-new:hover {
            background-color: #157347;
            border-color: #157347;
            color: white;
        }

    .btn-export {
        background-color: white;
        border: 1px solid #203f67;
        color: #203f67;
        font-size: 14px;
        font-weight: 600;
        padding: 7px 14px;
        border-radius: 4px;
        text-decoration: none;
    }

        .btn-export:hover {
            background-color: #203f67;
            color: white;
        }

    /* Main Card */
    .sales-order-card {
        background: white;
        border: 1px solid #b8c9df;
        border-radius: 5px;
        overflow: hidden;
    }

    .sales-order-card-header {
        background-color: #203f67;
        color: white;
        padding: 10px 16px;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0.3px;
    }

    .sales-order-card-body {
        padding: 16px;
    }

    /* Filter */
    .filter-box {
        border: 1px solid #c9d5e4;
        border-radius: 4px;
        padding: 12px;
        margin-bottom: 14px;
    }

    .filter-row {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .filter-label {
        color: #666;
        font-size: 13px;
        white-space: nowrap;
    }

    .keyword-input {
        width: 220px;
    }

    .date-input {
        width: 150px;
    }

    .filter-input {
        height: 36px;
        border: 1px solid #aebdce;
        border-radius: 4px;
        padding: 6px 10px;
        font-size: 13px;
        outline: none;
    }

        .filter-input:focus {
            border-color: #203f67;
            box-shadow: 0 0 0 2px rgba(32, 63, 103, 0.10);
        }

    .btn-search {
        height: 36px;
        background-color: #203f67;
        border: 1px solid #203f67;
        color: white;
        border-radius: 4px;
        padding: 0 16px;
        font-size: 13px;
        font-weight: 600;
    }

        .btn-search:hover {
            background-color: #183452;
            border-color: #183452;
        }

    .btn-reset {
        height: 36px;
        background-color: white;
        border: 1px solid #aebdce;
        color: #555;
        border-radius: 4px;
        padding: 0 14px;
        font-size: 13px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
    }

        .btn-reset:hover {
            background-color: #f4f6f8;
            color: #333;
        }

    /* Table */
    .table-wrapper {
        border: 1px solid #d0dbe8;
        border-radius: 4px;
        overflow-x: auto;
    }

    .sales-order-table {
        width: 100%;
        margin: 0;
        border-collapse: collapse;
        font-size: 13px;
    }

        .sales-order-table thead th {
            background-color: #e5ebf3;
            color: #203f67;
            font-weight: 700;
            border: 1px solid #c3cfde;
            padding: 8px 10px;
            white-space: nowrap;
            height: 34px;
        }

        .sales-order-table tbody td {
            border: 1px solid #d0dbe8;
            padding: 8px 10px;
            color: #444;
            height: 38px;
            vertical-align: middle;
        }

        .sales-order-table tbody tr:nth-child(even) {
            background-color: #f5f7fa;
        }

        .sales-order-table tbody tr:hover {
            background-color: #eef3f8;
        }

    .col-number {
        width: 45px;
        text-align: center;
    }

    .col-so {
        width: 150px;
    }

    .col-date {
        width: 120px;
    }

    .col-customer {
        width: 220px;
    }

    .col-address {
        min-width: 280px;
    }

    .col-action {
        width: 95px;
        text-align: center;
    }

    .so-number {
        color: #34495e;
        font-weight: 600;
    }

    .address-text {
        display: block;
        max-width: 380px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    /* Action buttons */
    .action-buttons {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 8px;
    }

    .btn-action {
        border: none;
        background: transparent;
        padding: 2px;
        font-size: 15px;
        cursor: pointer;
        line-height: 1;
    }

    .btn-edit {
        color: #f47b43;
    }

        .btn-edit:hover {
            color: #d95d27;
        }

    .btn-delete {
        color: #8a8a8a;
    }

        .btn-delete:hover {
            color: #d9534f;
        }

    /* Empty State */
    .empty-row td {
        text-align: center;
        color: #999;
        padding: 24px !important;
        font-style: italic;
    }

    /* Notification */
    .notification {
        margin-bottom: 14px;
        border-radius: 4px;
        font-size: 13px;
    }

    /* Footer */
    .table-footer {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        padding-top: 12px;
        color: #777;
        font-size: 12px;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .sales-order-page {
            padding: 16px;
        }

        .page-header {
            flex-direction: column;
            align-items: flex-start !important;
        }

        .page-actions {
            width: 100%;
        }

        .btn-add-new,
        .btn-export {
            flex: 1;
            text-align: center;
        }

        .filter-row {
            align-items: stretch;
            flex-direction: column;
        }

        .keyword-input,
        .date-input,
        .filter-input {
            width: 100%;
        }

        .btn-search,
        .btn-reset {
            width: 100%;
            justify-content: center;
        }
    }
</style>

<div class="sales-order-page">
    <div class="sales-order-wrapper">

        <!-- Page Header -->
        <div class="page-header d-flex justify-content-between align-items-center mb-3">

            <h1 class="page-title">
                Sales Order
            </h1>

            <div class="page-actions">

                <!-- Add New -->
                <a asp-controller="SalesOrders"
                   asp-action="Create"
                   class="btn-add-new">
                    + Add New
                </a>

                <!-- Export -->
                <a asp-controller="SalesOrders"
                   asp-action="Export"
                   asp-route-keyword="@Context.Request.Query["keyword"]"
                   asp-route-orderDate="@Context.Request.Query["orderDate"]"
                   class="btn-export">
                    ↓ Export
                </a>

            </div>

        </div>

        <!-- Main Card -->
        <div class="sales-order-card">

            <!-- Card Header -->
            <div class="sales-order-card-header">
                ORDER LIST
            </div>

            <div class="sales-order-card-body">

                <!-- Notification -->
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success notification alert-dismissible fade show">
                        <strong>Berhasil!</strong>
                        @TempData["Success"]

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="alert">
                        </button>
                    </div>
                }

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger notification alert-dismissible fade show">
                        <strong>Gagal!</strong>
                        @TempData["Error"]

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="alert">
                        </button>
                    </div>
                }

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger notification alert-dismissible fade show">
                        <strong>Error!</strong>
                        @ViewBag.Error

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="alert">
                        </button>
                    </div>
                }

                <!-- Search & Filter -->
                <div class="filter-box">

                    <form asp-controller="SalesOrders"
                          asp-action="Index"
                          method="get">

                        <div class="filter-row">

                            <span class="filter-label">
                                Keyword
                            </span>

                            <input type="text"
                                   name="keyword"
                                   value="@ViewBag.Keyword"
                                   class="filter-input keyword-input"
                                   placeholder="____________" />

                            <span class="filter-label">
                                Order Date
                            </span>

                            <input type="date"
                                   name="orderDate"
                                   value="@ViewBag.OrderDate"
                                   class="filter-input date-input" />

                            <button type="submit"
                                    class="btn-search">
                                🔍 Search
                            </button>

                            @if (!string.IsNullOrWhiteSpace(ViewBag.Keyword as string)
                                                        || ViewBag.OrderDate != null)
                            {
                                <a asp-controller="SalesOrders"
                                   asp-action="Index"
                                   class="btn-reset">
                                    Reset
                                </a>
                            }

                        </div>

                    </form>

                </div>

                <!-- Table -->
                <div class="table-wrapper">

                    <table class="sales-order-table">

                        <thead>

                            <tr>

                                <th class="col-number">
                                    #
                                </th>

                                <th class="col-so">
                                    SO Number
                                </th>

                                <th class="col-date">
                                    Order Date
                                </th>

                                <th class="col-customer">
                                    Customer
                                </th>

                                <th class="col-address">
                                    Address
                                </th>

                                <th class="col-action">
                                    Action
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @if (Model != null && Model.Any())
                            {
                                var no = 1;

                                foreach (var order in Model)
                                {
                                    <tr>

                                        <!-- Number -->
                                        <td class="col-number">
                                            @no
                                        </td>

                                        <!-- SO Number -->
                                        <td>
                                            <span class="so-number">
                                                @order.SO_NO
                                            </span>
                                        </td>

                                        <!-- Order Date -->
                                        <td>
                                            @order.ORDER_DATE.ToString("dd/MM/yyyy")
                                        </td>

                                        <!-- Customer -->
                                        <td>
                                            @order.CUSTOMER_NAME
                                        </td>

                                        <!-- Address -->
                                        <td>
                                            <span class="address-text"
                                                  title="@order.ADDRESS">
                                                @order.ADDRESS
                                            </span>
                                        </td>

                                        <!-- Action -->
                                        <td class="col-action">

                                            <div class="action-buttons">

                                                <!-- Edit -->
                                                <a asp-controller="SalesOrders"
                                                   asp-action="Edit"
                                                   asp-route-id="@order.SALES_SO_ID"
                                                   class="btn-action btn-edit"
                                                   title="Edit Sales Order">
                                                    ✏
                                                </a>

                                                <!-- Delete -->
                                                <button type="button"
                                                        class="btn-action btn-delete"
                                                        onclick="confirmDelete(@order.SALES_SO_ID, '@order.SO_NO')"
                                                        title="Delete Sales Order">
                                                    🗑
                                                </button>

                                            </div>

                                        </td>

                                    </tr>

                                    no++;
                                }
                            }
                            else
                            {
                                <tr class="empty-row">

                                    <td colspan="6">
                                        ... tidak ada data Sales Order ...
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

                <!-- Footer -->
                <div class="table-footer">

                    @if (Model != null && Model.Any())
                    {
                        <span>
                            Menampilkan @Model.Count data
                        </span>
                    }
                    else
                    {
                        <span>
                            Tidak ada data
                        </span>
                    }

                </div>

            </div>

        </div>

    </div>
</div>

@section Scripts {

    <script>

        function confirmDelete(id, soNo) {

            const confirmed = confirm(
                "Hapus order " +
                soNo +
                "?\n\nTindakan ini tidak dapat dibatalkan."
            );

            if (confirmed) {

                window.location.href =
                    "/SalesOrders/Delete/" + id;

            }

        }

    </script>

}